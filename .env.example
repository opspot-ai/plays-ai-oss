# Local Plays configuration template. Every service or credential value below is a placeholder.
FULFILLMENT_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=replace-with-test-stripe-key
STRIPE_WEBHOOK_SECRET=replace-with-test-webhook-secret
CRON_SECRET=replace-with-random-local-cron-secret

NEXT_PUBLIC_SITE_URL=http://localhost:4720
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-supabase-service-role-key
DEVICE_CODE_SECRET=replace-with-random-local-device-secret
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

BUNDLE_STORAGE_BUCKET=replace-with-local-storage-bucket
DOWNLOADS_PER_HOUR=20
